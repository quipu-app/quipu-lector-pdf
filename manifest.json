{
  "name": "Quipu - Lector y Estudio PDF",
  "short_name": "Quipu",
  "description": "Lector y editor de PDF para estudiantes con herramientas de subrayado, post-its, repaso activo y organización de apuntes.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0C1017",
  "theme_color": "#3B5E94",
  "categories": ["education", "productivity", "utilities"],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ]
}